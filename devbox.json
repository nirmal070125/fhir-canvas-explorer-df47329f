{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "bun@latest",
    "kubectl@latest",
    "kubernetes-helm@3.20.2",
    "k3d@latest",
    "jq@latest",
    "gettext@latest"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$PATH:$PWD/.devbox/bin\"",
      "command -v occ >/dev/null || echo 'occ not found — run: devbox run install-occ'"
    ],
    "scripts": {
      "install-occ": [
        "mkdir -p .devbox/bin",
        "OCC_VERSION=v1.2.2; ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); OS=$(uname -s | tr '[:upper:]' '[:lower:]')",
        "curl -fsSL \"https://github.com/openchoreo/openchoreo/releases/download/${OCC_VERSION}/occ_${OCC_VERSION}_${OS}_${ARCH}.tar.gz\" | tar -xz -C .devbox/bin occ"
      ],
      "bootstrap-platform": [
        "export PATH=\"$PATH:$PWD/.devbox/bin\"",
        "command -v occ >/dev/null || devbox run install-occ",
        "./openchoreo/bootstrap-platform.sh"
      ],
      "up": [
        "export PATH=\"$PATH:$PWD/.devbox/bin\"",
        "devbox run bootstrap-platform",
        "./openchoreo/setup.sh"
      ],
      "down": [
        "k3d cluster delete openchoreo"
      ],
      "dev": [
        "bun install",
        "bun run dev"
      ],
      "test": [
        "NODE_ENV=test bun run test"
      ]
    }
  }
}
