{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "bun@latest",
    "kubectl@latest",
    "kubernetes-helm@latest",
    "kind@latest",
    "jq@latest"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$PATH:$PWD/.devbox/bin\"",
      "command -v choreoctl >/dev/null || echo 'choreoctl not found — run: devbox run install-choreoctl'"
    ],
    "scripts": {
      "install-choreoctl": [
        "mkdir -p .devbox/bin",
        "curl -fsSL https://openchoreo.dev/install/choreoctl.sh | bash -s -- --install-dir .devbox/bin"
      ],
      "dev": ["bun install", "bun run dev"],
      "test": ["NODE_ENV=test bun run test"]
    }
  }
}
