# Local model (docker compose) needs no key; OPENAI_BASE_URL points the chat
# backend at llama.cpp. For hosted OpenAI instead, set OPENAI_API_KEY and
# leave OPENAI_BASE_URL unset. Revoke any key pasted into chat before use.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8081/v1
OPENAI_MODEL=qwen3.5-4b

# WSO2 FHIR MCP subprocess settings.
FHIR_MCP_REQUEST_TIMEOUT=30
FHIR_MCP_IDLE_TTL_MS=300000
